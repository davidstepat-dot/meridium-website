---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import NewsletterPopup from '@/components/NewsletterPopup.astro';
import GoogleTag from '@/components/GoogleTag.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { site } from '@/data/site';
import { altPath, type Lang } from '@/data/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // Stub pages carry noindex until their content phase lands.
  noindex?: boolean;
  lang?: Lang;
  // Extra schema.org nodes for this page (for example Service and FAQPage on
  // service pages). They join the site-wide nodes in one @graph.
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  noindex = false,
  lang = 'en',
  jsonLd: pageJsonLd = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const enUrl = new URL(altPath(Astro.url.pathname, 'en'), Astro.site);
const deUrl = new URL(altPath(Astro.url.pathname, 'de'), Astro.site);

// Structured data (schema.org). Search engines and AI assistants read this to
// identify the firm and connect the website, the LinkedIn page and third-party
// listings to one entity. Identifiers are completed as facts are confirmed
// (see src/data/site.ts). Pages add their own nodes through the jsonLd prop.
const organization = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  image: new URL('/og-default.jpg', site.url).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo.png', site.url).href,
    width: 1200,
    height: 734,
  },
  name: site.legalName,
  legalName: site.legalName,
  alternateName: site.brand,
  slogan: site.tagline,
  url: site.url,
  email: site.email,
  description: site.defaultDescription,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '143 Cecil Street, #09-01 GB Building',
    addressLocality: 'Singapore',
    postalCode: '069542',
    addressCountry: 'SG',
  },
  identifier: { '@type': 'PropertyValue', propertyID: 'UEN', value: site.uen },
  sameAs: [site.linkedin],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: site.email,
    url: site.bookingHref,
    availableLanguage: ['English', 'German'],
    areaServed: 'SG',
  },
  knowsLanguage: ['en', 'de'],
  areaServed: ['Singapore', 'Southeast Asia', 'India', 'China'],
  knowsAbout: [
    'Company incorporation in Singapore',
    'Corporate secretarial services',
    'Nominee resident director services',
    'Payroll and work passes',
    'Employer of record services in Singapore',
    'Accounting and tax compliance',
    'Regulatory licence applications',
    'Trademark registration',
    'Market entry advisory',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.brand,
  inLanguage: ['en-SG', 'de'],
  publisher: { '@id': `${site.url}/#organization` },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...pageJsonLd],
};
---

<!doctype html>
<html lang={lang === 'de' ? 'de' : 'en-SG'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleTag />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_SG'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white">
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <NewsletterPopup lang={lang} />
    <ConsentBanner lang={lang} />
  </body>
</html>
