---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import CTABand from '@/components/CTABand.astro';
import { site } from '@/data/site';
import merlionNight from '@/assets/merlion-night.jpg';
import marinaBayGold from '@/assets/marina-bay-gold.jpg';
import supertreesDawn from '@/assets/supertrees-dawn.jpg';

const services = (await getCollection('services', ({ id }) => id.startsWith('en/'))).sort(
  (a, b) => a.data.order - b.data.order
);

const engagementSteps = [
  {
    title: 'Scoping call',
    description:
      'A senior adviser hears your plans, flags the issues that matter and confirms whether we are the right fit.',
  },
  {
    title: 'Proposal and fee quote',
    description:
      'A written scope with a fixed fee wherever the work allows it, so there are no surprises later.',
  },
  {
    title: 'Onboarding and KYC',
    description:
      'Identity and compliance checks are completed once, cleanly, and reused across every service you take.',
  },
  {
    title: 'Ongoing delivery',
    description:
      'Work proceeds to an agreed calendar, with a named senior contact accountable for your whole file.',
  },
];

const differentiators = [
  {
    title: 'Senior-only delivery',
    description:
      'Every engagement is scoped, led and delivered by senior practitioners. Nobody learns the trade on your file.',
  },
  {
    title: 'A named contact who knows you',
    description:
      'You work with one senior contact who knows your entity, your deadlines and your plans across every service.',
  },
  {
    title: 'A deliberately small client book',
    description:
      'We cap the number of clients each adviser carries, so advice arrives when you need it, not when a queue clears.',
  },
];

const regions = [
  {
    name: 'ASEAN',
    description:
      'Manufacturing, consumer growth and regional supply chains, reached through established partners in the major ASEAN markets.',
  },
  {
    name: 'India',
    description:
      'A large domestic market with a well-worn Singapore holding route, coordinated with partners on the ground.',
  },
  {
    name: 'China',
    description:
      'Sourcing, manufacturing and market presence, managed at arm’s length from a neutral, well-regarded base.',
  },
];
---

<Base
  title="Singapore Corporate Services for Foreign Founders | Meridium"
  description={site.defaultDescription}
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="container-m grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.08] tracking-tight text-navy sm:text-5xl xl:text-[3.4rem]">
          Enter Asia through Singapore, with senior advisers on your file.
        </h1>
        <p class="mt-6 max-w-[58ch] text-lg leading-relaxed">
          Meridium is a licensed corporate services firm for foreign companies and founders
          establishing in Singapore. Incorporation, compliance, tax and expansion, handled end to
          end by the senior people you actually meet.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={site.bookingHref} class="btn-red">Book a call</a>
          <a href="#services" class="btn-outline-navy">Explore services</a>
        </div>
      </div>
      <div class="relative">
        <Image
          src={merlionNight}
          alt="The Merlion at night, spouting water towards the lit Singapore skyline"
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/3] w-full rounded-[3px] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Differentiator -->
  <section class="bg-ivory">
    <div class="container-m section grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <p class="eyebrow">Why Meridium</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          Most providers scale by volume. Meridium is built deliberately small.
        </h2>
        <p class="mt-5 max-w-[52ch] leading-relaxed">
          At high-volume firms, your company becomes one file among a hundred on a junior
          associate's desk. We take the opposite position: a small client book, senior-only
          delivery, and guarded capacity, so the quality of attention never dilutes.
        </p>
      </div>
      <ul class="space-y-8">
        {
          differentiators.map((d) => (
            <li class="border-t border-navy/15 pt-6">
              <h3 class="font-serif text-xl font-semibold tracking-tight text-navy">{d.title}</h3>
              <p class="mt-2 max-w-[58ch] leading-relaxed">{d.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services grid -->
  <section id="services" class="bg-white">
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          One firm across the corporate lifecycle.
        </h2>
        <p class="mt-5 leading-relaxed">
          Eight services, each delivered as a clearly scoped engagement, and each connected to the
          rest, so nothing falls between providers.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          services.map((s) => (
            <a
              href={`/services/${s.id.split('/')[1]}/`}
              class="group flex flex-col border border-line bg-white p-6 transition-colors hover:border-navy"
            >
              <h3 class="font-serif text-xl font-semibold tracking-tight text-navy">{s.data.title}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed">{s.data.outcome}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy">
                Explore
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2 8h11m0 0L9 4m4 4l-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Engagement process -->
  <section class="bg-ivory">
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">Working with us</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          How an engagement works.
        </h2>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          engagementSteps.map((step, i) => (
            <li class="border-t border-navy/15 pt-5">
              <span class="font-serif text-sm font-semibold text-navy/70" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 font-serif text-lg font-semibold tracking-tight text-navy">
                {step.title}
              </h3>
              <p class="mt-2 text-[15px] leading-relaxed">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Where we operate -->
  <section class="bg-white">
    <div class="container-m section grid items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">Where we operate</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          Singapore as the hub. The region within reach.
        </h2>
        <p class="mt-5 max-w-[58ch] leading-relaxed">
          We work from Singapore because it remains the most dependable base for Asian operations:
          a common law system, deep professional talent, capital mobility and a wide treaty
          network. Beyond Singapore, we support expansion into ASEAN, India and China through
          vetted partners in each market, coordinated by your Singapore team.
        </p>
        <dl class="mt-8 space-y-6">
          {
            regions.map((r) => (
              <div class="border-l-2 border-navy/20 pl-5">
                <dt class="font-serif text-lg font-semibold tracking-tight text-navy">{r.name}</dt>
                <dd class="mt-1 max-w-[58ch] text-[15px] leading-relaxed">{r.description}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Image
        src={supertreesDawn}
        alt="Supertree Grove at Gardens by the Bay at first light"
        widths={[480, 768, 1080]}
        sizes="(min-width: 1024px) 38vw, 100vw"
        class="aspect-[3/4] w-full rounded-[3px] object-cover"
        loading="lazy"
      />
    </div>
  </section>

  {/* Testimonials stay off until real client permission exists. See src/components/Testimonials.astro. */}

  <CTABand background={marinaBayGold} />
</Base>
