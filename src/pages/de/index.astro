---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import CTABand from '@/components/CTABand.astro';
import { site } from '@/data/site';
import merlionNight from '@/assets/merlion-night.jpg';
import marinaBayGold from '@/assets/marina-bay-gold.jpg';
import supertreesDawn from '@/assets/supertrees-dawn.jpg';

const services = (await getCollection('services', ({ id }) => id.startsWith('de/'))).sort(
  (a, b) => a.data.order - b.data.order
);

const engagementSteps = [
  {
    title: 'Erstgespräch',
    description:
      'Ein erfahrener Berater hört sich Ihre Pläne an, benennt die Punkte, auf die es ankommt, und sagt Ihnen offen, ob wir die Richtigen sind.',
  },
  {
    title: 'Angebot mit Festpreis',
    description:
      'Ein schriftlicher Leistungsumfang mit einem Festpreis, wo immer die Arbeit es zulässt. Ohne Überraschungen im Nachhinein.',
  },
  {
    title: 'Onboarding und KYC',
    description:
      'Identitäts- und Compliance-Prüfungen werden einmal sauber durchgeführt und für alle Ihre Leistungen wiederverwendet.',
  },
  {
    title: 'Laufende Betreuung',
    description:
      'Die Arbeit folgt einem vereinbarten Kalender, mit einem festen erfahrenen Ansprechpartner, der Ihr gesamtes Mandat verantwortet.',
  },
];

const differentiators = [
  {
    title: 'Ausschließlich erfahrene Berater',
    description:
      'Jedes Mandat wird von erfahrenen Praktikern kalkuliert, geführt und umgesetzt. Niemand lernt das Handwerk an Ihrem Mandat.',
  },
  {
    title: 'Ein fester Ansprechpartner, der Sie kennt',
    description:
      'Sie arbeiten mit einem erfahrenen Ansprechpartner, der Ihre Gesellschaft, Ihre Fristen und Ihre Pläne über alle Leistungen hinweg kennt.',
  },
  {
    title: 'Ein bewusst kleiner Mandantenstamm',
    description:
      'Wir begrenzen die Zahl der Mandate je Berater. So kommt der Rat, wenn Sie ihn brauchen, nicht wenn eine Warteschlange ihn freigibt.',
  },
];

const regions = [
  {
    name: 'ASEAN',
    description:
      'Fertigung, wachsende Konsummärkte und regionale Lieferketten, erschlossen über etablierte Partner in den wichtigsten ASEAN-Märkten.',
  },
  {
    name: 'Indien',
    description:
      'Ein großer Binnenmarkt mit einer bewährten Holding-Route über Singapur, umgesetzt mit Partnern vor Ort.',
  },
  {
    name: 'China',
    description:
      'Beschaffung, Fertigung und Marktpräsenz, geführt mit professionellem Abstand von einer neutralen, angesehenen Basis aus.',
  },
];
---

<Base
  title="Corporate Services in Singapur für ausländische Unternehmen | Meridium"
  description="Lizenzierte Corporate-Services-Firma in Singapur für ausländische Unternehmen auf dem Weg nach Asien: Gründung, Compliance, Steuern und Expansion, von erfahrenen Beratern."
  lang="de"
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="container-m grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.08] tracking-tight text-navy sm:text-5xl xl:text-[3.4rem]">
          Nach Asien über Singapur, mit erfahrenen Beratern an Ihrer Seite.
        </h1>
        <p class="mt-6 max-w-[58ch] text-lg leading-relaxed">
          Meridium ist eine lizenzierte Corporate-Services-Firma für ausländische Unternehmen und
          Gründer, die sich in Singapur niederlassen. Gründung, Compliance, Steuern und
          Expansion, durchgängig betreut von den erfahrenen Beratern, mit denen Sie tatsächlich
          sprechen.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={site.bookingHref} target="_blank" rel="noopener" class="btn-red">Gespräch vereinbaren</a>
          <a href="/de/resources/setup-planner/" class="btn-outline-navy">Markteintritt planen</a>
        </div>
      </div>
      <div class="relative">
        <Image
          src={merlionNight}
          alt="Der Merlion bei Nacht vor der beleuchteten Skyline Singapurs"
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/3] w-full rounded-[3px] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Differentiator -->
  <section class="bg-ivory">
    <div class="container-m section grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <p class="eyebrow">Warum Meridium</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          Die meisten Anbieter wachsen über Masse. Meridium bleibt bewusst klein.
        </h2>
        <p class="mt-5 max-w-[52ch] leading-relaxed">
          Bei Volumenanbietern wird Ihre Gesellschaft zu einer von hundert Akten auf dem
          Schreibtisch eines Junior-Mitarbeiters. Wir vertreten die Gegenposition: ein kleiner
          Mandantenstamm, ausschließlich erfahrene Berater und bewusst begrenzte Kapazität, damit
          die Qualität der Betreuung nie verwässert.
        </p>
      </div>
      <ul class="space-y-8">
        {
          differentiators.map((d) => (
            <li class="border-t border-navy/15 pt-6">
              <h3 class="font-serif text-xl font-semibold tracking-tight text-navy">{d.title}</h3>
              <p class="mt-2 max-w-[58ch] leading-relaxed">{d.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services grid -->
  <section id="services" class="bg-white">
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">Leistungen</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          Ein Anbieter für den gesamten Lebenszyklus Ihrer Gesellschaft.
        </h2>
        <p class="mt-5 leading-relaxed">
          Acht Leistungen, jede als klar umrissenes Mandat erbracht und jede mit den übrigen
          verbunden, damit nichts zwischen verschiedenen Anbietern verloren geht.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          services.map((s) => (
            <a
              href={`/de/services/${s.id.split('/')[1]}/`}
              class="group flex flex-col border border-line bg-white p-6 transition-colors hover:border-navy"
            >
              <h3 class="font-serif text-xl font-semibold tracking-tight text-navy">{s.data.title}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed">{s.data.outcome}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy">
                Mehr erfahren
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2 8h11m0 0L9 4m4 4l-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Engagement process -->
  <section class="bg-ivory">
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">Zusammenarbeit</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          So läuft ein Mandat ab.
        </h2>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          engagementSteps.map((step, i) => (
            <li class="border-t border-navy/15 pt-5">
              <span class="font-serif text-sm font-semibold text-navy/70" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 font-serif text-lg font-semibold tracking-tight text-navy">
                {step.title}
              </h3>
              <p class="mt-2 text-[15px] leading-relaxed">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Where we operate -->
  <section class="bg-white">
    <div class="container-m section grid items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">Wo wir tätig sind</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
          Singapur als Basis. Die Region in Reichweite.
        </h2>
        <p class="mt-5 max-w-[58ch] leading-relaxed">
          Wir arbeiten von Singapur aus, weil es die verlässlichste Basis für Aktivitäten in
          Asien bleibt: ein Common-Law-Rechtssystem, tiefe fachliche Expertise, freier
          Kapitalverkehr und ein breites Netz an Doppelbesteuerungsabkommen. Über Singapur hinaus
          begleiten wir Ihre Expansion nach ASEAN, Indien und China über geprüfte Partner im
          jeweiligen Markt, koordiniert von Ihrem Team in Singapur.
        </p>
        <dl class="mt-8 space-y-6">
          {
            regions.map((r) => (
              <div class="border-l-2 border-navy/20 pl-5">
                <dt class="font-serif text-lg font-semibold tracking-tight text-navy">{r.name}</dt>
                <dd class="mt-1 max-w-[58ch] text-[15px] leading-relaxed">{r.description}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Image
        src={supertreesDawn}
        alt="Der Supertree Grove in den Gardens by the Bay im ersten Morgenlicht"
        widths={[480, 768, 1080]}
        sizes="(min-width: 1024px) 38vw, 100vw"
        class="aspect-[3/4] w-full rounded-[3px] object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <CTABand lang="de" background={marinaBayGold} />
</Base>
