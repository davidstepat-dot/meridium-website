---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import CTABand from '@/components/CTABand.astro';
import { site } from '@/data/site';
import { team } from '@/data/team';
import marinaBayDay from '@/assets/marina-bay-day.jpg';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

<Base
  title={`Über uns | ${site.brand}`}
  description="Meridium ist eine lizenzierte Corporate-Services-Firma in Singapur: ausschließlich erfahrene Berater und ein bewusst kleiner Mandantenstamm."
  lang="de"
>
  <section class="border-b border-line bg-ivory">
    <div class="container-m py-14 md:py-20">
      <p class="eyebrow">Über Meridium</p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-[1.1] tracking-tight text-navy sm:text-5xl">
        Erfahrene Berater, ein kleiner Mandantenstamm, ein verantwortlicher Ansprechpartner.
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg leading-relaxed">
        Meridium Management Consultants ist eine lizenzierte Corporate-Services-Firma in
        Singapur. Wir betreuen ausländische Unternehmen und Gründer auf dem Weg nach Asien sowie
        die Berufsträger, die sie an uns verweisen.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-m section grid items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <h2 class="font-serif text-3xl font-semibold tracking-tight text-navy">
          Wofür wir stehen.
        </h2>
        <p class="mt-5 max-w-[58ch] leading-relaxed">
          Unsere Vision ist einfach formuliert und anspruchsvoll umgesetzt: die Kanzlei zu sein,
          der internationale Unternehmer ihre asiatische Basis so anvertrauen wie dem eigenen
          Führungsteam. Daraus folgt unsere Mission: Gründung, Compliance, Steuern und Expansion
          in Singapur so zuverlässig zu erbringen, dass die Gesellschaft unauffällig läuft und
          das Geschäft darauf wachsen kann.
        </p>
        <p class="mt-4 max-w-[58ch] leading-relaxed">
          Alles bei Meridium läuft über eine Beziehung. Wer Ihr Mandat kalkuliert, setzt es auch
          um. Wer es umsetzt, steht dafür ein. Und die Antwort kommt von jemandem, der Ihre Akte
          kennt, ohne sie aufschlagen zu müssen.
        </p>
      </div>
      <Image
        src={marinaBayDay}
        alt="Das zentrale Geschäftsviertel Singapurs, vom Wasser aus gesehen an einem klaren Tag"
        widths={[480, 768, 1080]}
        sizes="(min-width: 1024px) 38vw, 100vw"
        class="aspect-[4/3] w-full rounded-[3px] object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <section class="bg-ivory">
    <div class="container-m section">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl font-semibold tracking-tight text-navy">
          Das Senior-Only-Modell.
        </h2>
        <p class="mt-5 leading-relaxed">
          Die Corporate-Services-Branche skaliert über Hebelwirkung: Partner verkaufen, Juniors
          liefern, und Manager jonglieren Mandantenstämme von hundert und mehr. Die Rechnung geht
          für den Anbieter auf, für den Mandanten nicht. Meridium ist auf dem umgekehrten Prinzip
          gebaut.
        </p>
      </div>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        <li class="border-t border-navy/15 pt-5">
          <h3 class="font-serif text-lg font-semibold tracking-tight text-navy">
            Keine Juniors, die an Ihrem Mandat lernen
          </h3>
          <p class="mt-2 text-[15px] leading-relaxed">
            Jedes Mandat wird von erfahrenen Praktikern kalkuliert, geführt und umgesetzt.
            Ausbildung findet auf unsere Kosten statt, nicht auf Kosten Ihrer Gesellschaft.
          </p>
        </li>
        <li class="border-t border-navy/15 pt-5">
          <h3 class="font-serif text-lg font-semibold tracking-tight text-navy">
            Kein Manager mit 120 Mandanten
          </h3>
          <p class="mt-2 text-[15px] leading-relaxed">
            Wir begrenzen die Zahl der Mandate je Berater. Kapazitätsdisziplin ist der Preis der
            Erreichbarkeit, und wir zahlen ihn bewusst.
          </p>
        </li>
        <li class="border-t border-navy/15 pt-5">
          <h3 class="font-serif text-lg font-semibold tracking-tight text-navy">
            Eine Kanzlei über den gesamten Lebenszyklus
          </h3>
          <p class="mt-2 text-[15px] leading-relaxed">
            Gründung, Compliance, Payroll, Steuern, Markenschutz und Expansion greifen unter
            einem Dach ineinander, damit nichts zwischen Anbietern verloren geht.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {
    team.length > 0 && (
      <section class="bg-white">
        <div class="container-m section">
          <div class="max-w-2xl">
            <p class="eyebrow">Das Team</p>
            <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy">
              Die Menschen hinter Ihrem Mandat.
            </h2>
          </div>
          <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {team.map((member) => (
              <div class="border border-line p-6">
                {member.photo ? (
                  <Image
                    src={member.photo}
                    alt={`Porträt von ${member.name}`}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                    class="aspect-[4/5] w-full rounded-[3px] object-cover"
                  />
                ) : (
                  <div
                    class="flex h-20 w-20 items-center justify-center rounded-full bg-tint font-serif text-2xl font-semibold text-navy"
                    aria-hidden="true"
                  >
                    {initials(member.name)}
                  </div>
                )}
                <p class="mt-5 font-serif text-xl font-semibold tracking-tight text-navy">
                  {member.name}
                </p>
                <p class="mt-1 text-sm text-body/80">{member.roleDe}</p>
                {(member.bioDe ?? member.bio) && (
                  <p class="mt-3 text-[15px] leading-relaxed">{member.bioDe ?? member.bio}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand lang="de" />
</Base>
