---
import Base from '@/layouts/Base.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site } from '@/data/site';
---

<Base
  title={`Kontakt | ${site.brand}`}
  description="Sprechen Sie mit einem erfahrenen Meridium-Berater über Ihren Weg nach Asien über Singapur. Senden Sie eine Anfrage oder vereinbaren Sie ein Erstgespräch."
  lang="de"
>
  <section class="border-b border-line bg-ivory">
    <div class="container-m py-14 md:py-20">
      <p class="eyebrow">Kontakt</p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-[1.1] tracking-tight text-navy sm:text-5xl">
        Sprechen Sie mit einem erfahrenen Berater.
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg leading-relaxed">
        Schildern Sie uns Ihr Vorhaben, und ein erfahrener Praktiker meldet sich bei Ihnen, in
        der Regel innerhalb eines Geschäftstags. Ein Erstgespräch kostet nichts und verpflichtet
        Sie zu nichts. Wir beraten Sie gern auf Deutsch oder Englisch.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-m section grid gap-14 lg:grid-cols-[1.4fr_1fr]">
      <ContactForm lang="de" />
      <aside class="space-y-10 lg:pt-2">
        <div class="border border-line bg-tint p-6">
          <h2 class="font-serif text-xl font-semibold tracking-tight text-navy">Noch nicht bereit für ein Gespräch?</h2>
          <p class="mt-3 max-w-[44ch] text-[15px] leading-relaxed">Der Setup-Planer zeigt Ihnen in rund zwei Minuten Struktur, Zeitplan und Behördengebühren für Ihre Gesellschaft in Singapur, ohne Anmeldung.</p>
          <a href="/de/resources/setup-planner/" class="btn-outline-navy mt-5">Setup-Planer öffnen</a>
        </div>
        <div>
          <h2 class="font-serif text-xl font-semibold tracking-tight text-navy">Büro</h2>
          <p class="mt-3 leading-relaxed">
            {site.legalName}
            {site.addressLines.map((line) => <><br />{line}</>)}
          </p>
        </div>
        <div>
          <h2 class="font-serif text-xl font-semibold tracking-tight text-navy">E-Mail</h2>
          <p class="mt-3 leading-relaxed">
            <a
              href={`mailto:${site.email}`}
              class="font-medium text-navy underline decoration-navy/30 underline-offset-4 hover:decoration-navy"
            >
              {site.email}
            </a>
          </p>
        </div>
        <div>
          <h2 class="font-serif text-xl font-semibold tracking-tight text-navy">Empfehlende Berater</h2>
          <p class="mt-3 max-w-[44ch] text-[15px] leading-relaxed">
            Anwälte, Steuerberater und Handelskammern, die einen Mandanten empfehlen: Schreiben
            Sie uns direkt. Wir halten Sie genau in dem Maße informiert, das Ihr Mandant wünscht.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
