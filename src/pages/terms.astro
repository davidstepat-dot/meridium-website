---
import Base from '@/layouts/Base.astro';
import TermsBody from '@/components/TermsBody.astro';
import { site } from '@/data/site';
---

<Base
  title={`Terms of use | ${site.brand}`}
  description="Terms governing the use of the Meridium Management Consultants website."
>
  <section class="border-b border-line bg-ivory">
    <div class="container-m py-14 md:py-20">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-[1.1] tracking-tight text-navy sm:text-5xl">
        Terms of use
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg leading-relaxed">
        These terms govern the use of this website. They are not the terms of any engagement with
        {site.legalName}, which are agreed separately in writing.
      </p>
    </div>
  </section>
  <section class="bg-white">
    <div class="container-m section">
      <TermsBody />
    </div>
  </section>
</Base>
