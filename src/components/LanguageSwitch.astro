---
import { altPath, type Lang } from '@/data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
const enHref = altPath(path, 'en');
const deHref = altPath(path, 'de');

const active = 'px-1.5 py-1 text-navy underline decoration-2 underline-offset-4';
const inactive = 'px-1.5 py-1 text-navy/50 transition-colors hover:text-navy focus-visible:text-navy';
---

<div class="flex items-center text-sm font-semibold tracking-wide" role="group" aria-label="Language / Sprache">
  <a href={enHref} aria-label="English" aria-current={lang === 'en' ? 'true' : undefined} class={lang === 'en' ? active : inactive}>
    EN
  </a>
  <span class="text-navy/30" aria-hidden="true">|</span>
  <a href={deHref} aria-label="Deutsch" aria-current={lang === 'de' ? 'true' : undefined} class={lang === 'de' ? active : inactive}>
    DE
  </a>
</div>
