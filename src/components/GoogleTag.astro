---
// Google tag (gtag.js) in Google Consent Mode v2. Rendered in <head> from
// Base.astro, before any other script, so the consent defaults are in place
// before gtag.js loads.
//
//   - Every storage type starts as "denied": gtag.js sets no cookies and
//     uses no advertising identifiers, and ad click IDs are redacted.
//   - If the visitor accepted in the cookie banner (ConsentBanner.astro)
//     within the last 12 months, the stored choice is applied straight away
//     on each page load, before the first hit is sent.
//   - Otherwise the banner asks, and its Accept button sends the update.
//
// The measurement ID lives in src/data/site.ts (site.googleTag.id).
import { site } from '@/data/site';

const tagId = site.googleTag.id;
const adsConversions = site.googleAds.conversions;
---

{
  tagId && (
    <>
      <script is:inline define:vars={{ tagId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        try {
          var saved = JSON.parse(localStorage.getItem('meridium-consent') || 'null');
          if (saved && saved.choice === 'granted' && Date.now() - saved.at < 365 * 86400000) {
            gtag('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted',
            });
          }
        } catch (e) {
          /* storage blocked: stay on the denied defaults */
        }
        gtag('set', 'ads_data_redaction', true);
        gtag('js', new Date());
        gtag('config', tagId);
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${tagId}`} />
      <script is:inline define:vars={{ adsConversions }}>
        // Conversion events. Components call window.meridiumTrack(kind, params)
        // after a successful submission; kind is lead, signup or booking.
        // Each sends the matching Google Analytics event and, when a label is
        // set in site.googleAds.conversions, a Google Ads conversion too.
        // Nothing the visitor typed is ever included.
        (function () {
          var EVENTS = { lead: 'generate_lead', signup: 'sign_up', booking: 'book_call_click' };
          window.meridiumTrack = function (kind, params) {
            try {
              var name = EVENTS[kind] || kind;
              gtag('event', name, params || {});
              var label = adsConversions[kind];
              if (label) gtag('event', 'conversion', { send_to: label });
            } catch (e) {
              /* analytics unavailable */
            }
          };
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href*="calendly.com"]') : null;
            if (a) window.meridiumTrack('booking', { link_page: location.pathname });
          });
        })();
      </script>
    </>
  )
}
