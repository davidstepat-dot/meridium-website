---
// "Where are you starting from?" block under the homepage hero: one path for
// foreign companies establishing in Singapore, one for companies already
// operating here. Service link labels come from the service collection.
import { getCollection } from 'astro:content';
import { langPrefix, type Lang } from '@/data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const prefix = langPrefix(lang);
const entries = await getCollection('services', ({ id }) => id.startsWith(`${lang}/`));
const title = (slug: string) => entries.find((e) => e.id === `${lang}/${slug}`)?.data.title ?? slug;

const copy = {
  en: {
    eyebrow: 'Where are you starting from?',
    paths: [
      {
        label: 'Expanding into Asia',
        heading: 'Establishing your company in Singapore',
        body: 'For groups setting up a subsidiary, regional headquarters or holding company: structure, resident director, Employment Passes, bank account and licences, coordinated by one senior team.',
        cta: 'Plan your Singapore entity',
        href: `${prefix}/singapore-subsidiary/`,
        external: false,
        links: ['incorporation', 'payroll-hr', 'asia-expansion'],
      },
      {
        label: 'Already operating in Singapore',
        heading: 'Running your Singapore entity properly',
        body: 'For companies already here whose filings, books or payroll need a firmer hand: company secretarial, accounting and tax, payroll, and a senior adviser who raises issues before a regulator does. We handle a change of provider for you, including the handover of registers and records.',
        cta: 'See how we take over your entity',
        href: `${prefix}/singapore-operations/`,
        external: false,
        links: ['company-secretarial', 'accounting-tax', 'payroll-hr'],
      },
    ],
  },
  de: {
    eyebrow: 'Wo stehen Sie?',
    paths: [
      {
        label: 'Expansion nach Asien',
        heading: 'Ihre Gesellschaft in Singapur aufbauen',
        body: 'Für Unternehmensgruppen, die eine Tochtergesellschaft, eine Regionalzentrale oder eine Holding gründen: Struktur, ansässiger Director, Employment Passes, Bankkonto und Lizenzen, koordiniert von einem erfahrenen Team.',
        cta: 'Markteintritt planen',
        href: `${prefix}/singapore-subsidiary/`,
        external: false,
        links: ['incorporation', 'payroll-hr', 'asia-expansion'],
      },
      {
        label: 'Bereits in Singapur tätig',
        heading: 'Ihre Gesellschaft in Singapur richtig führen',
        body: 'Für Unternehmen vor Ort, deren Meldungen, Buchhaltung oder Lohnabrechnung eine festere Hand brauchen: Company Secretarial, Buchhaltung und Steuern, Lohnabrechnung und ein erfahrener Berater, der Probleme anspricht, bevor eine Behörde es tut. Einen Anbieterwechsel übernehmen wir für Sie, einschließlich der Übergabe von Registern und Unterlagen.',
        cta: 'So übernehmen wir Ihre Gesellschaft',
        href: `${prefix}/singapore-operations/`,
        external: false,
        links: ['company-secretarial', 'accounting-tax', 'payroll-hr'],
      },
    ],
  },
}[lang];
---

<section class="border-t border-line bg-white">
  <div class="container-m py-12 md:py-16">
    <p class="eyebrow">{copy.eyebrow}</p>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        copy.paths.map((p) => (
          <div class="flex flex-col border border-line border-t-[3px] border-t-navy bg-white p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red">{p.label}</p>
            <h2 class="mt-3 font-serif text-2xl font-semibold tracking-tight text-navy">{p.heading}</h2>
            <p class="mt-3 flex-1 max-w-[58ch] leading-relaxed">{p.body}</p>
            <div class="mt-6">
              {p.external ? (
                <a href={p.href} target="_blank" rel="noopener" class="btn-red">
                  {p.cta}
                </a>
              ) : (
                <a href={p.href} class="btn-red">
                  {p.cta}
                </a>
              )}
            </div>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14px]">
              {p.links.map((slug) => (
                <li>
                  <a
                    href={`${prefix}/services/${slug}/`}
                    class="font-medium text-navy underline decoration-navy/30 underline-offset-4 hover:decoration-navy"
                  >
                    {title(slug)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
