---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import { ui, type Lang } from '@/data/i18n';

interface Props {
  lang?: Lang;
  heading?: string;
  body?: string;
  // Optional photographic texture behind the band; sits under a heavy navy
  // overlay so text contrast is unaffected. Used on the homepage only.
  background?: ImageMetadata;
}

const { lang = 'en', background } = Astro.props;
const t = ui[lang];
const { heading = t.cta.heading, body = t.cta.body } = Astro.props;
---

<section class="relative bg-navy">
  {
    background && (
      <>
        <Image
          src={background}
          alt=""
          widths={[1280, 1920]}
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-navy/80" aria-hidden="true" />
      </>
    )
  }
  <div class="container-m section relative text-center">
    <h2 class="mx-auto max-w-2xl font-serif text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      {heading}
    </h2>
    <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/80">{body}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={site.bookingHref} class="btn-red">{t.cta.book}</a>
      <a href={`mailto:${site.email}`} class="btn-outline-white">{t.cta.writeTo} {site.email}</a>
    </div>
  </div>
</section>
