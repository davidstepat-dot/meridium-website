---
// Ad landing pages: /singapore-subsidiary/ and /singapore-operations/ (and
// their /de/ versions). Copy: src/data/landing.ts. The subsidiary page embeds
// the setup planner; the operations page leads with a review call.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import CTABand from '@/components/CTABand.astro';
import SetupPlanner from '@/components/SetupPlanner.astro';
import { site } from '@/data/site';
import { langPrefix, ui, type Lang } from '@/data/i18n';
import { landing, type LandingKey } from '@/data/landing';
import supertreesAerial from '@/assets/supertrees-aerial.jpg';
import marinaBayDusk from '@/assets/marina-bay-dusk.jpg';

interface Props {
  page: LandingKey;
  lang?: Lang;
}

const { page, lang = 'en' } = Astro.props;
const c = landing[lang][page];
const prefix = langPrefix(lang);
const entries = await getCollection('services', ({ id }) => id.startsWith(`${lang}/`));
const services = c.services.slugs
  .map((slug) => entries.find((e) => e.id === `${lang}/${slug}`))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const resolve = (href: string) =>
  href === 'planner'
    ? { href: '#planner', external: false }
    : href === 'booking'
      ? { href: site.bookingHref, external: true }
      : href === 'contact'
        ? { href: `${prefix}/contact/`, external: false }
        : { href: site.resources.complianceCalendarHref, external: true };
const primary = { ...c.hero.primary, ...resolve(c.hero.primary.href) };
const secondary = { ...c.hero.secondary, ...resolve(c.hero.secondary.href) };
const offerCta = c.offer ? { ...c.offer.cta, ...resolve(c.offer.cta.href) } : null;
const heroImage = page === 'subsidiary' ? supertreesAerial : marinaBayDusk;
const heroAlt =
  page === 'subsidiary'
    ? lang === 'de'
      ? 'Supertree Grove in den Gardens by the Bay von oben'
      : 'Supertree Grove at Gardens by the Bay seen from above'
    : lang === 'de'
      ? 'Marina Bay in Singapur in der Abenddämmerung'
      : 'Marina Bay in Singapore at dusk';

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    inLanguage: lang === 'de' ? 'de' : 'en-SG',
    mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const linkClass = 'font-medium text-navy underline decoration-navy/30 underline-offset-4 hover:decoration-navy';
---

<Base title={c.meta.title} description={c.meta.description} lang={lang} jsonLd={jsonLd}>
  <section class="bg-white">
    <div class="container-m grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.08] tracking-tight text-navy sm:text-5xl">
          {c.hero.heading}
        </h1>
        <p class="mt-6 max-w-[58ch] text-lg leading-relaxed">{c.hero.intro}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={primary.href} class="btn-red" {...primary.external ? { target: '_blank', rel: 'noopener' } : {}}>{primary.label}</a>
          <a href={secondary.href} class="btn-outline-navy" {...secondary.external ? { target: '_blank', rel: 'noopener' } : {}}>{secondary.label}</a>
        </div>
      </div>
      <Image
        src={heroImage}
        alt={heroAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        class="aspect-[4/3] w-full rounded-[3px] object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="border-y border-line bg-tint">
      <ul class="container-m grid gap-x-8 gap-y-3 py-5 text-[14px] font-medium text-navy sm:grid-cols-2 lg:grid-cols-4">
        {
          c.hero.facts.map((f) => (
            <li class="flex items-center gap-2.5">
              <svg class="h-3.5 w-3.5 shrink-0 text-red" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">{c.list.eyebrow}</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">{c.list.heading}</h2>
      </div>
      <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          c.list.items.map((item) => (
            <li class="border-t border-navy/15 pt-5">
              <h3 class="font-serif text-lg font-semibold tracking-tight text-navy">{item.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    c.planner && (
      <section class="border-t border-line bg-ivory">
        <div class="container-m section">
          <div class="max-w-2xl">
            <p class="eyebrow">{c.planner.eyebrow}</p>
            <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">{c.planner.heading}</h2>
            <p class="mt-5 leading-relaxed">{c.planner.intro}</p>
          </div>
          <div class="mt-10 border border-line bg-white p-5 sm:p-8">
            <SetupPlanner lang={lang} />
          </div>
        </div>
      </section>
    )
  }

  <section class={c.planner ? 'bg-white' : 'bg-ivory'}>
    <div class="container-m section">
      <div class="max-w-2xl">
        <p class="eyebrow">{c.steps.eyebrow}</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-navy sm:text-4xl">{c.steps.heading}</h2>
      </div>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.steps.items.map((step, i) => (
            <li class="border-t border-navy/15 pt-5">
              <span class="font-serif text-sm font-semibold text-navy/70" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 font-serif text-lg font-semibold tracking-tight text-navy">{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6">
        <span class="text-sm font-semibold uppercase tracking-[0.14em] text-navy/70">{c.services.heading}</span>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
          {services.map((s) => (
            <li><a href={`${prefix}/services/${s.id.split('/')[1]}/`} class={linkClass}>{s.data.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {
    c.offer && offerCta && (
      <section class="bg-white">
        <div class="container-m pb-4 pt-2">
          <div class="flex flex-col gap-5 border border-line bg-tint p-6 sm:p-8 md:flex-row md:items-center md:justify-between">
            <div class="max-w-2xl">
              <p class="font-serif text-xl font-semibold tracking-tight text-navy">{c.offer.heading}</p>
              <p class="mt-2 text-[15px] leading-relaxed">{c.offer.body}</p>
            </div>
            <a href={offerCta.href} target="_blank" rel="noopener" class="btn-outline-navy shrink-0 bg-white">{offerCta.label}</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-white">
    <div class="container-m section">
      <h2 class="max-w-2xl font-serif text-3xl font-semibold tracking-tight text-navy">{c.faqHeading}</h2>
      <div class="mt-8 max-w-3xl divide-y divide-line border-y border-line">
        {
          c.faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-semibold tracking-tight text-navy [&::-webkit-details-marker]:hidden">
                {faq.q}
                <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-45" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="mt-3 max-w-[62ch] leading-relaxed">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand lang={lang} heading={c.cta.heading} body={ui[lang].cta.body} />
</Base>
